[options]
; written by OmniaCLI from its template odoo-17-machine: changed here, it is
; written again at the next change of the instance's parameters
addons_path = {{ADDONS_PATH}}
data_dir = /var/lib/odoo
http_interface = 0.0.0.0
proxy_mode = True
db_name = {{DB_NAME}}
dbfilter = ^{{DB_NAME}}$
list_db = False
; the machine's cluster: what Odoo creates lands in the workspace's tablespace
db_template = {{DB_TEMPLATE}}
admin_passwd = {{ADMIN_PASSWD}}
