set -e

case "$1" in
    remove)
        # the workspaces' helpers are gone with the venv
        rm -f /etc/sudoers.d/omniacli-workspaces
        rm -f /etc/sudoers.d/omniacli-self-update
        rm -rf /opt/omniacli/venv /opt/omniacli/venv.old /opt/omniacli/python /opt/omniacli/python.old /opt/omniacli/.python.*
        ;;
    purge)
        rm -f /etc/sudoers.d/omniacli-workspaces
        rm -f /etc/sudoers.d/omniacli-self-update
        rm -rf /opt/omniacli/venv /opt/omniacli/venv.old /opt/omniacli/python /opt/omniacli/python.old /opt/omniacli/.python.*
        # the names published through another machine (relay.py): here the tunnels to a relay (their units,
        # keys and user); as a relay the tunnels hosted (their sites, certificates, the user omniacli-relay
        # and the Match block of sshd_config)
        for unit in /etc/systemd/system/omniacli-relay-*.service; do
            [ -e "$unit" ] || continue
            systemctl disable --now "$(basename "$unit")" >/dev/null 2>&1 || true
            rm -f "$unit"
        done
        rm -rf /etc/omniacli/relay
        # this machine's SSH published through a relay for its central panel (AD-017 §17.6): its unit and key
        if [ -e /etc/systemd/system/omniacli-agent-relay.service ]; then
            systemctl disable --now omniacli-agent-relay.service >/dev/null 2>&1 || true
            rm -f /etc/systemd/system/omniacli-agent-relay.service
        fi
        rm -rf /etc/omniacli/agent-relay
        # the units of the helpers (workspacehelper, machinedb, relay), each one's first line «# written by omniacli
        # workspace-helper»: the firewall of the workspaces, the timer of the Log in as path, the storages' binds,
        # the workspaces' disks and slices, docker's drop-ins after those disks, the slice and the mounts of the
        # machine's PostgreSQL. Each disabled and deleted; stopped too, but a storage's bind, a disk and a slice:
        # stopping them would unmount the disks and kill the containers of the instances, which the purge leaves
        # running (as their disks and the machine's PostgreSQL), until the machine starts again
        # (begin of the helpers' units)
        for unit in /etc/systemd/system/*.service /etc/systemd/system/*.timer /etc/systemd/system/*.mount \
                /etc/systemd/system/*.slice /etc/systemd/system/docker.service.d/omniacli-*.conf; do
            [ -f "$unit" ] || continue
            head -n 1 "$unit" | grep -q '^# written by omniacli workspace-helper' || continue
            case "$unit" in
                */docker.service.d/*) ;;
                */omniacli-storage-*.service|*.mount|*.slice)
                    systemctl disable "$(basename "$unit")" >/dev/null 2>&1 || true ;;
                *)
                    systemctl disable --now "$(basename "$unit")" >/dev/null 2>&1 || true ;;
            esac
            rm -f "$unit"
        done
        rmdir /etc/systemd/system/docker.service.d 2>/dev/null || true
        # (end of the helpers' units)
        if id omniacli-tunnel >/dev/null 2>&1; then userdel omniacli-tunnel || true; fi
        rm -f /etc/nginx/conf.d/omniacli-relay-*.conf
        rm -rf /etc/omniacli/certs/relay-*
        for lineage in /etc/letsencrypt/live/omniacli-relay-*; do
            [ -e "$lineage" ] || continue
            certbot delete --cert-name "$(basename "$lineage")" --non-interactive >/dev/null 2>&1 || true
        done
        rm -f /etc/omniacli/relay-hosted.json /etc/omniacli/relay-agents.json /etc/omniacli/.relay.lock
        # as a relay of machines' SSH: the user the central panels come in as, its home and keys
        if id omniacli-relay-jump >/dev/null 2>&1; then
            pkill -KILL -u omniacli-relay-jump || true
            userdel omniacli-relay-jump || true
        fi
        rm -rf /var/lib/omniacli-relay-jump
        if id omniacli-relay >/dev/null 2>&1; then
            pkill -KILL -u omniacli-relay || true
            userdel omniacli-relay || true
        fi
        rm -rf /var/lib/omniacli-relay
        if grep -q "^# OmniaCLI relay: " /etc/ssh/sshd_config 2>/dev/null; then
            sed -i '/^# OmniaCLI relay: /,/^# end of OmniaCLI relay$/d' /etc/ssh/sshd_config
            systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
        fi
        # the names of the workspaces passed to another machine (workspace-helper forward, AD-012): their sites
        # and records
        rm -f /etc/nginx/conf.d/omniacli-forward-*.conf
        rm -rf /etc/omniacli/forward /etc/omniacli/forwarded
        # the customers' certificates (workspace-helper owncert) of the workspaces that have no site any more: a
        # workspace's site that stays (its instances are not removed by the purge) serves with its own
        for own in /etc/omniacli/certs/*; do
            [ -e "$own" ] || continue
            [ -e "/etc/nginx/conf.d/omniacli-$(basename "$own").conf" ] && continue
            rm -rf "$own"
        done
        rmdir /etc/omniacli/certs 2>/dev/null || true
        if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
            systemctl reload nginx 2>/dev/null || true
        fi
        # the databases that were arriving here from another machine (managedreplica.ArrivePlace): the firewall's list
        rm -f /etc/omniacli/db-arrivals.json
        # root's records of the firewall and of the copies of the databases (workspacehelper, machinedb): what
        # listens for other machines, the databases of other machines, the stagings that may not send mail, the
        # copies hosted here and the dedicated databases copied elsewhere
        for kept in db-listen db-remote mail-guard machine-db-replica dedicated-replica; do
            rm -f "/etc/omniacli/$kept.json" "/etc/omniacli/$kept.json.tmp"
        done
        rm -f /etc/omniacli/omniacli.yaml /etc/omniacli/initial-admin-password
        # the main configuration a central panel's backup brought beside this one (omniacli central-restore)
        rm -f /etc/omniacli/omniacli.yaml.from-backup /etc/omniacli/.central-restore-*
        rm -f /etc/systemd/system/omniacli.service.d/omniacli-user.conf
        rmdir /etc/systemd/system/omniacli.service.d 2>/dev/null || true
        rmdir /etc/omniacli 2>/dev/null || true
        # the configuration, the histories, the logs and the scripts go; the
        # backups stay. The logs hold the access log, all its numbered files
        # (accesslog.py, kept by time for NIS 2): docs/nis2-audit.md says to
        # export it before a purge
        rm -rf /var/lib/omniacli/jobs /var/lib/omniacli/logs /var/lib/omniacli/scripts \
            /var/lib/omniacli/pullers /var/lib/omniacli/publications /var/lib/omniacli/connections \
            /var/lib/omniacli/packages /var/lib/omniacli/plugins /var/lib/omniacli/templates /var/lib/omniacli/catalog \
            /var/lib/omniacli/deploys /var/lib/omniacli/module-uploads /var/lib/omniacli/enterprise \
            /var/lib/omniacli/credentials /var/lib/omniacli/ssh /var/lib/omniacli/brand
        # the copy engine of the handover and of the move (treesync.py): the state of its copies, their listings
        # and plans, the hashes of the files it read, a dump it brought here and had not restored yet
        rm -rf /var/lib/omniacli/treesync
        # the protection of a central panel (centralbackup.py): what a backup left if it stopped half way
        rm -rf /var/lib/omniacli/.central-backup-*
        # and what omniacli central-restore wrote: the CA files of the links, a file it was writing when it stopped
        rm -rf /var/lib/omniacli/link-ca
        rm -f /var/lib/omniacli/.central-restore-*
        # the identities of the linked machines' workspaces imported on a central panel (identityimport.py, AD-018
        # slice 1): their hashes and secrets (600); a package staged by the first build of it (none is any more)
        rm -rf /var/lib/omniacli/identity-imports
        rm -f /var/lib/omniacli/.identity-package-*
        # the central panel as the home of those workspaces (remotehome.py, AD-018 slice 2): its switch per link, the
        # sessions of the people it serves; on a machine, the workspaces whose people a central panel serves
        rm -f /var/lib/omniacli/workspace-homes.json /var/lib/omniacli/workspace-homes.json.*.tmp \
            /var/lib/omniacli/remote-sessions.json /var/lib/omniacli/remote-sessions.json.tmp \
            /var/lib/omniacli/central-home.json /var/lib/omniacli/central-home.json.tmp
        # the one-time links of a second step to set up again after a machine passed (identitypass.py, AD-018 slice
        # 5): their hashes, 600; on the machine the pass is kept in central-home.json, above
        rm -f /var/lib/omniacli/second-factor-links.json /var/lib/omniacli/second-factor-links.json.*.tmp
        # the moves of instances to other machines (placement.py, AD-015): their states, the instances placed
        # elsewhere, the workspaces hosted here for their home
        rm -rf /var/lib/omniacli/move
        # the handovers of workspaces to a customer's OmniaCLI and the receptions from a provider (handover.py,
        # AD-008): the hashes of the codes and sessions, the keys of the claims, the parts of the copies
        rm -rf /var/lib/omniacli/handover
        # the extracts of a provider's access log a workspace received brought with it (AD-009, D-A8)
        rm -rf /var/lib/omniacli/access-archive
        # and the jobs of their hosts a home answered through itself (the delegated scope, AD-014)
        rm -f /var/lib/omniacli/placements.json /var/lib/omniacli/placements.json.tmp \
            /var/lib/omniacli/hosted-workspaces.json /var/lib/omniacli/hosted-workspaces.json.tmp \
            /var/lib/omniacli/placed-jobs.json /var/lib/omniacli/placed-jobs.json.tmp
        # the copies of Odoo Enterprise root kept for the instances (enterprise.py)
        rm -rf /var/lib/omniacli-enterprise
        # the templates installed from the download server (the instances
        # made from them keep their own files)
        rm -rf /var/lib/omniacli-templates
        # the packages kept for the way back and the runs of the updates from the panel (selfupdate.py)
        rm -rf /var/lib/omniacli-self-update
        rm -f /var/lib/omniacli/servers.yaml /var/lib/omniacli/servers.yaml.bak \
            /var/lib/omniacli/servers.yaml.tmp \
            /var/lib/omniacli/users.yaml /var/lib/omniacli/users.yaml.tmp \
            /var/lib/omniacli/links.yaml /var/lib/omniacli/links.yaml.tmp \
            /var/lib/omniacli/link-agents.json /var/lib/omniacli/link-agents.json.tmp \
            /var/lib/omniacli/link-panels.json /var/lib/omniacli/link-panels.json.tmp \
            /var/lib/omniacli/central-backup.json /var/lib/omniacli/central-backup.json.tmp \
            /var/lib/omniacli/invitations.yaml /var/lib/omniacli/invitations.yaml.tmp \
            /var/lib/omniacli/groups.yaml /var/lib/omniacli/groups.yaml.tmp \
            /var/lib/omniacli/options.yaml /var/lib/omniacli/options.yaml.tmp \
            /var/lib/omniacli/pullers.yaml /var/lib/omniacli/pullers.yaml.tmp \
            /var/lib/omniacli/publications.yaml /var/lib/omniacli/publications.yaml.tmp \
            /var/lib/omniacli/connections.yaml /var/lib/omniacli/connections.yaml.tmp \
            /var/lib/omniacli/schedules.yaml /var/lib/omniacli/schedules.yaml.tmp \
            /var/lib/omniacli/schedule_history.json /var/lib/omniacli/schedule_history.json.tmp \
            /var/lib/omniacli/disk_history.json /var/lib/omniacli/disk_history.tmp \
            /var/lib/omniacli/load_history.json /var/lib/omniacli/load_history.tmp \
            /var/lib/omniacli/stagings.json /var/lib/omniacli/stagings.json.tmp \
            /var/lib/omniacli/postgres_tuning.json /var/lib/omniacli/postgres_tuning.json.part \
            /var/lib/omniacli/sessions.json /var/lib/omniacli/sessions.json.tmp \
            /var/lib/omniacli/oauth.json /var/lib/omniacli/oauth.json.tmp \
            /var/lib/omniacli/monitor.json /var/lib/omniacli/monitor.json.tmp \
            /var/lib/omniacli/login-hosts.json /var/lib/omniacli/login-hosts.json.tmp \
            /var/lib/omniacli/pitr.json /var/lib/omniacli/pitr.json.tmp \
            /var/lib/omniacli/deploy-hooks.json /var/lib/omniacli/deploy-hooks.json.tmp \
            /var/lib/omniacli/destinations.yaml /var/lib/omniacli/destinations.yaml.tmp \
            /var/lib/omniacli/enterprise.yaml /var/lib/omniacli/enterprise.yaml.tmp \
            /var/lib/omniacli/webnames.json /var/lib/omniacli/webnames.json.tmp \
            /var/lib/omniacli/bell.json /var/lib/omniacli/bell.json.tmp \
            /var/lib/omniacli/github-hooks.json /var/lib/omniacli/github-hooks.json.tmp \
            /var/lib/omniacli/second-factor.json /var/lib/omniacli/second-factor.json.tmp \
            /var/lib/omniacli/passkeys.json /var/lib/omniacli/passkeys.json.tmp \
            /var/lib/omniacli/sso.json /var/lib/omniacli/sso.json.tmp /var/lib/omniacli/webhook-ref.key \
            /var/lib/omniacli/api-idempotency.json /var/lib/omniacli/api-idempotency.json.tmp \
            /var/lib/omniacli/credentials.yaml /var/lib/omniacli/credentials.yaml.tmp \
            /var/lib/omniacli/relays.json /var/lib/omniacli/relays.json.tmp \
            /var/lib/omniacli/agent-relay.json /var/lib/omniacli/agent-relay.json.tmp \
            /var/lib/omniacli/workspaces.yaml /var/lib/omniacli/workspaces.yaml.tmp
        if [ -d /var/lib/omniacli/backups ] && [ -n "$(ls -A /var/lib/omniacli/backups)" ]; then
            echo "omniacli: the database backups are kept in /var/lib/omniacli/backups"
        else
            rm -rf /var/lib/omniacli
        fi
        ;;
esac

# systemd, as dh_installsystemd writes it
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = "remove" ] && [ -x "/usr/bin/deb-systemd-helper" ]; then
    deb-systemd-helper mask 'omniacli.service' >/dev/null || true
fi
if [ "$1" = "purge" ] && [ -x "/usr/bin/deb-systemd-helper" ]; then
    deb-systemd-helper purge 'omniacli.service' >/dev/null || true
    deb-systemd-helper unmask 'omniacli.service' >/dev/null || true
fi

exit 0
