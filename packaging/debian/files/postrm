set -e

case "$1" in
    remove)
        # the workspaces' helpers are gone with the venv
        rm -f /etc/sudoers.d/omniacli-workspaces
        rm -rf /opt/omniacli/venv /opt/omniacli/venv.old /opt/omniacli/python /opt/omniacli/python.old /opt/omniacli/.python.*
        ;;
    purge)
        rm -f /etc/sudoers.d/omniacli-workspaces
        rm -rf /opt/omniacli/venv /opt/omniacli/venv.old /opt/omniacli/python /opt/omniacli/python.old /opt/omniacli/.python.*
        # the names published through another machine (relay.py): here the tunnels to a relay (their units,
        # keys and user); as a relay the tunnels hosted (their sites, certificates, the user omniacli-relay
        # and the Match block of sshd_config)
        for unit in /etc/systemd/system/omniacli-relay-*.service; do
            [ -e "$unit" ] || continue
            systemctl disable --now "$(basename "$unit")" >/dev/null 2>&1 || true
            rm -f "$unit"
        done
        rm -rf /etc/omniacli/relay
        if id omniacli-tunnel >/dev/null 2>&1; then userdel omniacli-tunnel || true; fi
        rm -f /etc/nginx/conf.d/omniacli-relay-*.conf
        rm -rf /etc/omniacli/certs/relay-*
        for lineage in /etc/letsencrypt/live/omniacli-relay-*; do
            [ -e "$lineage" ] || continue
            certbot delete --cert-name "$(basename "$lineage")" --non-interactive >/dev/null 2>&1 || true
        done
        rm -f /etc/omniacli/relay-hosted.json /etc/omniacli/.relay.lock
        if id omniacli-relay >/dev/null 2>&1; then
            pkill -KILL -u omniacli-relay || true
            userdel omniacli-relay || true
        fi
        rm -rf /var/lib/omniacli-relay
        if grep -q "^# OmniaCLI relay: " /etc/ssh/sshd_config 2>/dev/null; then
            sed -i '/^# OmniaCLI relay: /,/^# end of OmniaCLI relay$/d' /etc/ssh/sshd_config
            systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
        fi
        if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
            systemctl reload nginx 2>/dev/null || true
        fi
        rm -f /etc/omniacli/omniacli.yaml /etc/omniacli/initial-admin-password
        rm -f /etc/systemd/system/omniacli.service.d/omniacli-user.conf
        rmdir /etc/systemd/system/omniacli.service.d 2>/dev/null || true
        rmdir /etc/omniacli 2>/dev/null || true
        # the configuration, the histories, the logs and the scripts go; the
        # backups stay. The logs hold the access log, all its numbered files
        # (accesslog.py, kept by time for NIS 2): docs/nis2-audit.md says to
        # export it before a purge
        rm -rf /var/lib/omniacli/jobs /var/lib/omniacli/logs /var/lib/omniacli/scripts \
            /var/lib/omniacli/pullers /var/lib/omniacli/publications /var/lib/omniacli/connections \
            /var/lib/omniacli/packages /var/lib/omniacli/plugins /var/lib/omniacli/templates /var/lib/omniacli/catalog \
            /var/lib/omniacli/deploys /var/lib/omniacli/module-uploads /var/lib/omniacli/enterprise \
            /var/lib/omniacli/credentials /var/lib/omniacli/ssh /var/lib/omniacli/brand
        # the copies of Odoo Enterprise root kept for the instances (enterprise.py)
        rm -rf /var/lib/omniacli-enterprise
        # the templates installed from the download server (the instances
        # made from them keep their own files)
        rm -rf /var/lib/omniacli-templates
        rm -f /var/lib/omniacli/servers.yaml /var/lib/omniacli/servers.yaml.bak \
            /var/lib/omniacli/servers.yaml.tmp \
            /var/lib/omniacli/users.yaml /var/lib/omniacli/users.yaml.tmp \
            /var/lib/omniacli/links.yaml /var/lib/omniacli/links.yaml.tmp \
            /var/lib/omniacli/groups.yaml /var/lib/omniacli/groups.yaml.tmp \
            /var/lib/omniacli/options.yaml /var/lib/omniacli/options.yaml.tmp \
            /var/lib/omniacli/pullers.yaml /var/lib/omniacli/pullers.yaml.tmp \
            /var/lib/omniacli/publications.yaml /var/lib/omniacli/publications.yaml.tmp \
            /var/lib/omniacli/connections.yaml /var/lib/omniacli/connections.yaml.tmp \
            /var/lib/omniacli/schedules.yaml /var/lib/omniacli/schedules.yaml.tmp \
            /var/lib/omniacli/schedule_history.json /var/lib/omniacli/schedule_history.json.tmp \
            /var/lib/omniacli/disk_history.json /var/lib/omniacli/disk_history.tmp \
            /var/lib/omniacli/load_history.json /var/lib/omniacli/load_history.tmp \
            /var/lib/omniacli/stagings.json /var/lib/omniacli/stagings.json.tmp \
            /var/lib/omniacli/postgres_tuning.json /var/lib/omniacli/postgres_tuning.json.part \
            /var/lib/omniacli/sessions.json /var/lib/omniacli/sessions.json.tmp \
            /var/lib/omniacli/oauth.json /var/lib/omniacli/oauth.json.tmp \
            /var/lib/omniacli/monitor.json /var/lib/omniacli/monitor.json.tmp \
            /var/lib/omniacli/login-hosts.json /var/lib/omniacli/login-hosts.json.tmp \
            /var/lib/omniacli/pitr.json /var/lib/omniacli/pitr.json.tmp \
            /var/lib/omniacli/deploy-hooks.json /var/lib/omniacli/deploy-hooks.json.tmp \
            /var/lib/omniacli/destinations.yaml /var/lib/omniacli/destinations.yaml.tmp \
            /var/lib/omniacli/enterprise.yaml /var/lib/omniacli/enterprise.yaml.tmp \
            /var/lib/omniacli/webnames.json /var/lib/omniacli/webnames.json.tmp \
            /var/lib/omniacli/bell.json /var/lib/omniacli/bell.json.tmp \
            /var/lib/omniacli/github-hooks.json /var/lib/omniacli/github-hooks.json.tmp \
            /var/lib/omniacli/second-factor.json /var/lib/omniacli/second-factor.json.tmp \
            /var/lib/omniacli/passkeys.json /var/lib/omniacli/passkeys.json.tmp \
            /var/lib/omniacli/sso.json /var/lib/omniacli/sso.json.tmp \
            /var/lib/omniacli/api-idempotency.json /var/lib/omniacli/api-idempotency.json.tmp \
            /var/lib/omniacli/credentials.yaml /var/lib/omniacli/credentials.yaml.tmp \
            /var/lib/omniacli/relays.json /var/lib/omniacli/relays.json.tmp \
            /var/lib/omniacli/workspaces.yaml /var/lib/omniacli/workspaces.yaml.tmp
        if [ -d /var/lib/omniacli/backups ] && [ -n "$(ls -A /var/lib/omniacli/backups)" ]; then
            echo "omniacli: the database backups are kept in /var/lib/omniacli/backups"
        else
            rm -rf /var/lib/omniacli
        fi
        ;;
esac

# systemd, as dh_installsystemd writes it
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = "remove" ] && [ -x "/usr/bin/deb-systemd-helper" ]; then
    deb-systemd-helper mask 'omniacli.service' >/dev/null || true
fi
if [ "$1" = "purge" ] && [ -x "/usr/bin/deb-systemd-helper" ]; then
    deb-systemd-helper purge 'omniacli.service' >/dev/null || true
    deb-systemd-helper unmask 'omniacli.service' >/dev/null || true
fi

exit 0
